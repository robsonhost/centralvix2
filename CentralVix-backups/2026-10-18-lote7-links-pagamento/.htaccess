
# Pagina publica CENTRALVIX
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^$ /cvix-public.php [L,QSA]
  RewriteRule ^login\.php$ /cvix-public.php?p=login [L,QSA]

  RewriteCond %{QUERY_STRING} !rp=
  RewriteRule ^index\.php$ /cvix-public.php [L,QSA]

  RewriteCond %{QUERY_STRING} (?:^|&)incorrect=
  RewriteRule ^clientarea\.php$ /cvix-public.php?p=login [L,QSA]

  RewriteCond %{REQUEST_METHOD} !POST
  RewriteRule ^contact\.php$ /cvix-public.php?p=contato [L,QSA]

  RewriteCond %{REQUEST_METHOD} !POST
  RewriteRule ^register\.php$ /cvix-public.php?p=cadastro [L,QSA]

  RewriteRule ^(recursos|planos|beneficios|sobre|contato|cadastro|2via|catalogo|hospedagem|revenda|revenda-hospedagem|vps|vps-brasil|vps-canada|streaming|revenda-streaming|web-radio|aplicativos|sites|desenvolvimento)/?$ /cvix-public.php?p=$1 [L,QSA]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Defina o pacote “ea-php82” como a linguagem padrão de programação “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
